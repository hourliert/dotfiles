#!/usr/bin/env bash
set -euo pipefail

# Idempotent setup script for dotfiles on a Figma devbox (Ubuntu/Linuxbrew).
# Called by the devbox hook on every start: bash scripts/setup

DOTFILES_DIR="$HOME/dotfiles"

# --- Bootstrap Homebrew into PATH ---
if [[ -f /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

if ! command -v brew &>/dev/null; then
  echo "Installing Homebrew..."
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  # Source the freshly installed brew
  if [[ -f /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  elif [[ -f /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  fi
fi

# --- Homebrew packages ---
# Install missing formulae in one pass to avoid repeated brew calls on re-runs.
formulae=(rcm neovim tmux fzf starship zplug)
missing=()
for f in "${formulae[@]}"; do
  if ! brew list "$f" &>/dev/null; then
    missing+=("$f")
  fi
done

if [[ ${#missing[@]} -gt 0 ]]; then
  echo "Installing: ${missing[*]}"
  brew install "${missing[@]}"
fi

# --- Terminfo for tmux true color support ---
if ! infocmp tmux-256color &>/dev/null 2>&1; then
  echo "Installing tmux-256color terminfo..."
  tic -x -e tmux-256color "$(brew --prefix)/share/terminfo/74/tmux-256color" 2>/dev/null \
    || curl -fsSL https://invisible-island.net/datafiles/current/terminfo.src.gz \
       | gunzip | tic -x -e tmux-256color -
fi

# --- tree-sitter CLI (compiled from source to match system glibc) ---
if ! command -v tree-sitter &>/dev/null || ! tree-sitter --version &>/dev/null 2>&1; then
  echo "Installing tree-sitter-cli via cargo..."
  sudo apt-get install -y -qq libclang-dev
  cargo install tree-sitter-cli
fi

# --- Ruby gems ---
if ! command -v tmuxinator &>/dev/null; then
  echo "Installing tmuxinator..."
  gem install tmuxinator
fi

# --- Oh-My-Zsh ---
if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
  echo "Installing Oh-My-Zsh..."
  sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
fi

# --- Symlink dotfiles via rcm ---
echo "Running rcup..."
rcup -f -v -d "$DOTFILES_DIR"

# --- TPM (Tmux Plugin Manager) ---
TPM_DIR="$HOME/.tmux/plugins/tpm"
if [[ ! -d "$TPM_DIR" ]]; then
  echo "Installing TPM..."
  git clone https://github.com/tmux-plugins/tpm "$TPM_DIR"
fi
# Install/update tmux plugins non-interactively
"$TPM_DIR/bin/install_plugins"

echo "Setup complete."
