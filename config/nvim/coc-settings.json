{
  "coc.preferences.formatOnSaveFiletypes": [
    "javascript",
    "typescript",
    "typescriptreact",
    "json",
    "javascriptreact",
    "css",
    "scss",
    "markdown",
    "md",
    "json",
    "graphql"
  ],
  "suggest.maxCompleteItemCount": 100,
  "suggest.autoTrigger": "always",
  "diagnostic.displayByAle": true,
  "typescript.updateImportsOnFileMove.enable": false,
  "javascript.updateImportsOnFileMove.enable": false,
  "tsserver.enableJavascript": false,
  "solargraph.completion": false,
  "solargraph.hover": false,
  "solargraph.formatting": false,
  "solargraph.diagnostics": false,
  "languageserver": {
    "flow": {
      "command": "flow",
      "args": ["lsp"],
      "filetypes": ["javascript", "javascriptreact"],
      "initializationOptions": {},
      "requireRootPattern": true,
      "settings": {},
      "rootPatterns": [".flowconfig"]
    }
  }
}
