[github]
  user = hourliert
[user]
	email = hourliert@gmail.com
	name = Thomas Hourlier
[push]
  default = current
[core]
	excludesfile = /Users/thomashourlier/.gitignore_global
	editor = nvim
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[alias]
  aa = add --all
  ap = add --patch
	cm = commit -m
  cv = commit -v
  co = checkout
  d = diff -w
  p = push
  pl = pull
  s = stash
  sa = stash -u
  delete-merged-branches = !git branch --merged | grep -v 'master$' | xargs git branch -d
  overview = log --all --since='1 weeks' --oneline --no-merges
  prr = !hub pull-request
  up = !git fetch origin && git rebase origin/master
